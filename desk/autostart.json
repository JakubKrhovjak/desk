{
  "jetbrains-toolbox": {
    "command": [
      "/opt/jetbrains-toolbox/jetbrains-toolbox"
    ],
    "tray": true
  },
  "ferdium": {
    "command": [
      "/usr/bin/ferdium"
    ],
    "tray": false
  },
  "arch-assistant": {
    "command": [
      "~/projects/arch-assistant/bin/arch-assistant"
    ],
    "tray": true
  },
  "org.kde.kdeconnect.nonplasma": {
    "command": [
      "kdeconnect-indicator"
    ],
    "tray": false
  }
}
