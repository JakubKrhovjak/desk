[Icon Theme]
Name=Desk
Comment=Simpleton app and folder icons for desk (own name, so Plasma keeps its plain Simpleton), the rest comes from desk/build-icon-theme.sh
Inherits=hicolor
Directories=scalable/apps,scalable/preferences,scalable/places

[scalable/apps]
Size=48
MinSize=8
MaxSize=512
Context=Applications
Type=Scalable

[scalable/preferences]
Size=48
MinSize=8
MaxSize=512
Context=Applications
Type=Scalable

[scalable/places]
Size=48
MinSize=8
MaxSize=512
Context=Places
Type=Scalable
