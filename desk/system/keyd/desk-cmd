# Vrstva klávesy Command pro prostředí desk: drží jako Ctrl, výjimky ovládají okna přes Super.
# Na fyzickou klávesu ji napojí až ~/.config/desk/keyd-mode.sh, v Plasmě a Caelestii se nepoužívá.
[cmd:C]
left = M-left
right = M-right
up = M-up
down = M-down
f = M-f
q = M-q
# Systémové zkratky jako na Macu, řeší je ~/.config/desk/keybinds.lua
space = M-space
m = M-m
h = M-h
# F23 při drženém Ctrl: přepínač oken zůstane otevřený, dokud je Command dole
tab = f23
