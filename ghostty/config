# Ghostty: modrošedé barvy ze schématu Caelestie; červená a zelená zůstávají kvůli čitelnosti chyb a diffů
font-family = Hack Nerd Font Mono
font-size = 11
cursor-style = bar
cursor-style-blink = false
cursor-color = #afc9eb
window-padding-x = 2
window-padding-y = 2
background = #161a1f
background-opacity = 1
background-blur = false
foreground = #e1e5ef
selection-background = #303c4c
selection-foreground = #e1e5ef
palette = 0=#161a1f
palette = 1=#ed1515
palette = 2=#44853a
palette = 3=#f67400
palette = 4=#7fa6d6
palette = 5=#9b59b6
palette = 6=#1abc9c
palette = 7=#e1e5ef
palette = 8=#71767e
palette = 9=#c0392b
palette = 10=#55a649
palette = 11=#fdbc4b
palette = 12=#afc9eb
palette = 13=#8e44ad
palette = 14=#16a085
palette = 15=#ffffff
shell-integration = zsh

# Zkratky jako v Ghostty na macOS. Klávesa Command posílá Super přes ~/.config/desk/keyd-mode.sh, nová zkratka patří do obou seznamů
keybind = super+c=copy_to_clipboard:mixed
keybind = super+v=paste_from_clipboard
keybind = super+a=select_all
keybind = super+k=clear_screen
keybind = super+t=new_tab
keybind = super+n=new_window
keybind = super+w=close_surface
keybind = super+shift+w=close_window
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+bracket_left=goto_split:previous
keybind = super+bracket_right=goto_split:next
keybind = super+shift+bracket_left=previous_tab
keybind = super+shift+bracket_right=next_tab
keybind = super+digit_1=goto_tab:1
keybind = super+digit_2=goto_tab:2
keybind = super+digit_3=goto_tab:3
keybind = super+digit_4=goto_tab:4
keybind = super+digit_5=goto_tab:5
keybind = super+digit_6=goto_tab:6
keybind = super+digit_7=goto_tab:7
keybind = super+digit_8=goto_tab:8
keybind = super+digit_9=last_tab
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+digit_0=reset_font_size
keybind = super+enter=toggle_fullscreen
keybind = super+shift+enter=toggle_split_zoom
keybind = super+comma=open_config:os_open
keybind = super+shift+comma=reload_config
keybind = super+shift+p=toggle_command_palette
keybind = super+backspace=text:\x15
keybind = alt+arrow_left=esc:b
keybind = alt+arrow_right=esc:f
# Cmd + šipka nahoru a dolů: keyd posílá Ctrl + Home a End (system/keyd/desk-cmd), zsh je nezná
keybind = ctrl+home=scroll_to_top
keybind = ctrl+end=scroll_to_bottom
